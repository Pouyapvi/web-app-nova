{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8c61d490-7394-4615-b35f-8ca097933947","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f758d5b58a82499f8d4f9d34a491575a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
